{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DatabaseConfiguration": {
    "EnableExecuteQuery": true,
    "EnableExecuteStoredProcedure": true,
    "EnableStartQuery": true,
    "EnableStartStoredProcedure": true,
    "DefaultCommandTimeoutSeconds": 30,
    "ConnectionTimeoutSeconds": 15,
    "MaxConcurrentSessions": 10,
    "SessionCleanupIntervalMinutes": 60,
    "TotalToolCallTimeoutSeconds": 120
  },
  "CustomTools": [
    {
      "ToolName": "get_customer_orders",
      "Description": "Retrieves all orders for a specific customer with optional filtering",
      "StoredProcedure": "dbo.usp_GetCustomerOrders",
      "DatabaseName": null,
      "DefaultTimeoutSeconds": 60,
      "Enabled": true,
      "RequiresExecutePermission": true,
      "Parameters": [
        {
          "Name": "customerId",
          "Description": "Customer ID (e.g., 'ALFKI')",
          "SqlParameterName": "CustomerId",
          "Type": "string",
          "Required": true,
          "MaxLength": 10
        },
        {
          "Name": "includeDetails",
          "Description": "Include detailed line items",
          "SqlParameterName": "IncludeDetails",
          "Type": "bool",
          "Required": false,
          "DefaultValue": false
        },
        {
          "Name": "year",
          "Description": "Filter by year (optional)",
          "SqlParameterName": "FilterYear",
          "Type": "int",
          "Required": false,
          "MinValue": 1990,
          "MaxValue": 2099
        }
      ]
    },
    {
      "ToolName": "get_monthly_sales_report",
      "Description": "Generates a comprehensive monthly sales report with revenue and trends",
      "StoredProcedure": "rpt.usp_GenerateMonthlySalesReport",
      "DatabaseName": null,
      "DefaultTimeoutSeconds": 300,
      "Enabled": true,
      "RequiresExecutePermission": true,
      "Parameters": [
        {
          "Name": "year",
          "Description": "Report year (2000-2099)",
          "SqlParameterName": "ReportYear",
          "Type": "int",
          "Required": true,
          "MinValue": 2000,
          "MaxValue": 2099
        },
        {
          "Name": "month",
          "Description": "Report month (1-12)",
          "SqlParameterName": "ReportMonth",
          "Type": "int",
          "Required": true,
          "MinValue": 1,
          "MaxValue": 12
        },
        {
          "Name": "includeProducts",
          "Description": "Include product breakdown in report",
          "SqlParameterName": "IncludeProducts",
          "Type": "bool",
          "Required": false,
          "DefaultValue": true
        },
        {
          "Name": "minRevenue",
          "Description": "Minimum revenue threshold for filtering",
          "SqlParameterName": "MinRevenue",
          "Type": "decimal",
          "Required": false,
          "MinValue": 0
        }
      ]
    },
    {
      "ToolName": "check_stock_levels",
      "Description": "Check current inventory stock levels with optional filtering",
      "StoredProcedure": "inv.usp_CheckStockLevels",
      "DatabaseName": null,
      "DefaultTimeoutSeconds": 30,
      "Enabled": true,
      "RequiresExecutePermission": true,
      "Parameters": [
        {
          "Name": "category",
          "Description": "Product category filter",
          "SqlParameterName": "Category",
          "Type": "string",
          "Required": false,
          "MaxLength": 50,
          "AllowedValues": ["Beverages", "Condiments", "Confections", "Dairy Products", "Grains/Cereals", "Meat/Poultry", "Produce", "Seafood"]
        },
        {
          "Name": "lowStockOnly",
          "Description": "Show only products with low stock levels",
          "SqlParameterName": "LowStockOnly",
          "Type": "bool",
          "Required": false,
          "DefaultValue": false
        },
        {
          "Name": "threshold",
          "Description": "Low stock threshold quantity",
          "SqlParameterName": "LowStockThreshold",
          "Type": "int",
          "Required": false,
          "DefaultValue": 10,
          "MinValue": 1,
          "MaxValue": 1000
        }
      ]
    }
  ]
}
